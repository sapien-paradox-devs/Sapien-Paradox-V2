# Copy to .env. Every value here is optional — a fresh clone runs with none of them
# (SQLite, local filesystem storage, console WhatsApp, no companion). D5.

# ── Core ─────────────────────────────────────────────────────────────────────
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ── Database (D5) ────────────────────────────────────────────────────────────
# Unset → SQLite at apps/api/db.sqlite3
DATABASE_URL=
DATABASE_SSL_REQUIRE=false

# ── Object storage — Cloudflare R2, S3-compatible (D23) ──────────────────────
# THE BUCKET MUST BE PRIVATE. Nothing here generates a storage URL; PDFs are
# streamed through the API. A public bucket bypasses grants and expiry entirely.
# Unset → local filesystem, for dev.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto

# ── Origins — SPA and API are sibling subdomains (D6) ────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Production only, e.g. .sapienparadox.com — makes the session cookie first-party.
# Leave empty locally.
COOKIE_DOMAIN=
# Public URL of the SPA. Used to build the links that go into WhatsApp messages.
APP_BASE_URL=http://localhost:5173

# ── Temporal access ──────────────────────────────────────────────────────────
GRANT_TTL_DAYS=7                    # D8
RESET_TOKEN_TTL_MINUTES=60          # D21

# ── Rate limits — counted from table rows, there is no Redis (D17) ───────────
REISSUE_COOLDOWN_MINUTES=60         # D9
CHAPTER_SEND_COOLDOWN_MINUTES=60    # D11
RESET_REQUEST_COOLDOWN_MINUTES=15   # D21

# ── Cadence delays in days, per pace key (D19) ───────────────────────────────
# Config, never a table. Override for a fast demo.
PACE_DELAY_DAYS_SLOW=7
PACE_DELAY_DAYS_MEDIUM=3
PACE_DELAY_DAYS_FAST=1

# ── WhatsApp — Twilio (D12, D16, D17) ────────────────────────────────────────
# Unset → console backend. Local work and CI never touch the network.
WHATSAPP_BACKEND=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_MAX_ATTEMPTS=3

# ── The companion — Anthropic (D13, D24) ─────────────────────────────────────
# Budget against $3/$15. Prompt caching with the 1h TTL is a build requirement,
# not an optimisation.
ANTHROPIC_API_KEY=
COMPANION_MODEL=claude-sonnet-5
COMPANION_CACHE_TTL=1h
COMPANION_MAX_INPUT_CHARS=2000
COMPANION_DAILY_MESSAGES_PER_GRANT=40
COMPANION_DAILY_MESSAGES_GLOBAL=500
